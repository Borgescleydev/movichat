generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      String   @default("agent")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedContacts Contact[] @relation("AssignedAgent")
}

model PipelineColumn {
  id        String   @id @default(cuid())
  name      String
  order     Int
  isDefault Boolean  @default(false)
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
}

model Contact {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?
  notes        String?
  columnId     String
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  column     PipelineColumn @relation(fields: [columnId], references: [id])
  assignedTo User?          @relation("AssignedAgent", fields: [assignedToId], references: [id])
  messages   Message[]
}

model Message {
  id        String   @id @default(cuid())
  contactId String
  body      String
  fromMe    Boolean  @default(false)
  timestamp DateTime @default(now())
  status    String   @default("received")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model WhatsAppSession {
  id          String   @id @default("default")
  status      String   @default("disconnected")
  qrCode      String?
  phone       String?
  instanceId  String?
  providerId  String?
  updatedAt   DateTime @updatedAt
}

model ApiProvider {
  id          String   @id @default(cuid())
  name        String
  type        String   // uazapi | evolution | custom
  baseUrl     String
  apiKey      String
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)
  webhookUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances   WhatsAppInstance[]
}

model WhatsAppInstance {
  id           String   @id @default(cuid())
  providerId   String
  instanceName String
  instanceId   String?
  status       String   @default("disconnected")
  phone        String?
  qrCode       String?
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider  ApiProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  groups    WhatsAppGroup[]
  campaigns Campaign[]
}

model WhatsAppGroup {
  id               String   @id @default(cuid())
  instanceId       String
  groupJid         String
  name             String
  participantCount Int      @default(0)
  lastSyncAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  instance       WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  campaignGroups CampaignGroup[]
  dispatches     CampaignDispatch[]

  @@unique([instanceId, groupJid])
}

model MessageTemplate {
  id           String   @id @default(cuid())
  name         String
  body         String
  variables    String   @default("[]")
  mediaType    String?
  mediaUrl     String?
  mediaCaption String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns Campaign[]
}

model Campaign {
  id                String    @id @default(cuid())
  name              String
  description       String?
  status            String    @default("draft")
  templateId        String
  instanceId        String
  variableValues    String    @default("{}")
  startAt           DateTime
  repeatType        String    @default("none")
  repeatEndAt       DateTime?
  nextRunAt         DateTime?
  runCount          Int       @default(0)
  cadenceMinSeconds Int       @default(10)
  cadenceMaxSeconds Int       @default(30)
  cadenceMaxPerHour Int       @default(60)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  template   MessageTemplate  @relation(fields: [templateId], references: [id])
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id])
  groups     CampaignGroup[]
  dispatches CampaignDispatch[]
}

model CampaignGroup {
  id         String @id @default(cuid())
  campaignId String
  groupId    String
  order      Int    @default(0)

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    WhatsAppGroup @relation(fields: [groupId], references: [id])

  @@unique([campaignId, groupId])
}

model CampaignDispatch {
  id           String    @id @default(cuid())
  campaignId   String
  groupId      String
  runIndex     Int       @default(0)
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  errorMessage String?
  messageId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    WhatsAppGroup @relation(fields: [groupId], references: [id])

  @@unique([campaignId, groupId, runIndex])
}

model SystemSettings {
  id        String   @id @default("default")
  themeJson String   @default("{}")
  updatedAt DateTime @updatedAt
}
