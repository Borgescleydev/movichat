generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  password    String
  role        String   @default("agent")
  active      Boolean  @default(true)
  avatar      String?
  permissions String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignedContacts    Contact[]          @relation("AssignedAgent")
  ownedInstances      WhatsAppInstance[] @relation("InstanceOwner")
  sessions            UserSession[]
  campaigns           Campaign[]         @relation("CampaignCreator")
  contactCampaigns    ContactCampaign[]  @relation("ContactCampaignCreator")
  messageTemplates    MessageTemplate[]  @relation("MessageTemplateCreator")
  contactTemplates    ContactTemplate[]  @relation("ContactTemplateCreator")
  dispatchGroups      DispatchGroup[]    @relation("DispatchGroupCreator")
  contactGroups       ContactGroup[]      @relation("ContactGroupCreator")
  manualSchedules     ScheduledManualDispatch[] @relation("ManualScheduleCreator")
  quickDispatches     QuickDispatch[]    @relation("QuickDispatchCreator")
}

model Contact {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String?
  notes        String?
  assignedToId String?
  instanceId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo         User?                    @relation("AssignedAgent", fields: [assignedToId], references: [id])
  instance           WhatsAppInstance?        @relation(fields: [instanceId], references: [id])
  campaignContacts   ContactCampaignContact[]
  campaignDispatches ContactCampaignDispatch[]
  contactGroupItems  ContactGroupItem[]
}

model WhatsAppSession {
  id          String   @id @default("default")
  status      String   @default("disconnected")
  qrCode      String?
  phone       String?
  instanceId  String?
  providerId  String?
  updatedAt   DateTime @updatedAt
}

model ApiProvider {
  id          String   @id @default(cuid())
  name        String
  type        String   // uazapi | evolution | custom
  baseUrl     String
  apiKey      String
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)
  webhookUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances   WhatsAppInstance[]
}

model WhatsAppInstance {
  id                   String   @id @default(cuid())
  providerId           String
  ownerId              String?
  instanceName         String
  instanceId           String?
  status               String   @default("disconnected")
  phone                String?
  qrCode               String?
  label                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  provider         ApiProvider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  owner            User?                @relation("InstanceOwner", fields: [ownerId], references: [id])
  groups           WhatsAppGroup[]
  campaigns        Campaign[]
  manualLogs       ManualDispatchLog[]
  manualSchedules  ScheduledManualDispatch[]
  contacts         Contact[]
  contactCampaigns ContactCampaign[]
  contactGroups    ContactGroup[]
  quickDispatches  QuickDispatch[]
}

model WhatsAppGroup {
  id               String   @id @default(cuid())
  instanceId       String
  groupJid         String
  name             String
  participantCount Int      @default(0)
  lastSyncAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  instance            WhatsAppInstance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  campaignGroups      CampaignGroup[]
  dispatches          CampaignDispatch[]
  dispatchGroupItems  DispatchGroupItem[]
  contactGroups       ContactGroup[]

  @@unique([instanceId, groupJid])
}

model DispatchGroup {
  id           String   @id @default(cuid())
  name         String
  description  String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User?              @relation("DispatchGroupCreator", fields: [createdById], references: [id])
  items     DispatchGroupItem[]
}

model DispatchGroupItem {
  id              String @id @default(cuid())
  dispatchGroupId String
  groupId         String

  dispatchGroup DispatchGroup @relation(fields: [dispatchGroupId], references: [id], onDelete: Cascade)
  group         WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([dispatchGroupId, groupId])
}

model MessageTemplate {
  id           String   @id @default(cuid())
  name         String
  body         String
  variables    String   @default("[]")
  mediaType    String?
  mediaUrl     String?
  mediaCaption String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User?      @relation("MessageTemplateCreator", fields: [createdById], references: [id])
  campaigns Campaign[]

  @@index([createdById, updatedAt])
}

model Campaign {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  status               String    @default("draft")
  channel              String    @default("whatsapp")
  sendType             String    @default("scheduled")
  templateId           String
  instanceId           String
  variableValues       String    @default("{}")
  startAt              DateTime
  repeatType           String    @default("none")
  repeatEndAt          DateTime?
  nextRunAt            DateTime?
  runCount             Int       @default(0)
  cadenceMinSeconds    Int       @default(10)
  cadenceMaxSeconds    Int       @default(30)
  cadenceMaxPerHour    Int       @default(60)
  windowStart          String?
  windowEnd            String?
  windowDays           String    @default("[]")
  batchSize            Int?
  batchIntervalMinutes Int?
  repeatEveryX         Int?
  repeatEveryUnit      String?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  createdBy  User?            @relation("CampaignCreator", fields: [createdById], references: [id])
  template   MessageTemplate  @relation(fields: [templateId], references: [id])
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id])
  groups     CampaignGroup[]
  dispatches CampaignDispatch[]
}

model CampaignGroup {
  id         String @id @default(cuid())
  campaignId String
  groupId    String
  order      Int    @default(0)

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    WhatsAppGroup @relation(fields: [groupId], references: [id])

  @@unique([campaignId, groupId])
}

model CampaignDispatch {
  id           String    @id @default(cuid())
  campaignId   String
  groupId      String
  runIndex     Int       @default(0)
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  errorMessage String?
  messageId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    WhatsAppGroup @relation(fields: [groupId], references: [id])

  @@unique([campaignId, groupId, runIndex])
}

model ManualDispatchLog {
  id           String   @id @default(cuid())
  instanceId   String
  message      String
  mediaType    String?
  mediaCaption String?
  hasMedia     Boolean  @default(false)
  groupCount   Int      @default(0)
  sentCount    Int      @default(0)
  failedCount  Int      @default(0)
  results      String   @default("[]")
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  instance WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model ScheduledManualDispatch {
  id           String   @id @default(cuid())
  instanceId   String
  message      String
  mediaType    String?
  mediaUrl     String?
  mediaCaption String?
  fileName     String?
  groupIds     String   @default("[]")
  scheduledFor DateTime
  status       String   @default("scheduled")
  errorMessage String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instance  WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("ManualScheduleCreator", fields: [createdById], references: [id])
}

model ContactGroup {
  id               String   @id @default(cuid())
  name             String
  description      String?
  sourceGroupId    String?
  sourceGroupName  String?
  sourceGroupJid   String?
  sourceInstanceId String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceGroup    WhatsAppGroup?    @relation(fields: [sourceGroupId], references: [id], onDelete: SetNull)
  sourceInstance WhatsAppInstance? @relation(fields: [sourceInstanceId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("ContactGroupCreator", fields: [createdById], references: [id])
  items          ContactGroupItem[]
}

model ContactGroupItem {
  id             String   @id @default(cuid())
  contactGroupId String
  contactId      String
  sourcePhone    String?
  sourceName     String?
  rawJson        String?
  createdAt      DateTime @default(now())

  contactGroup ContactGroup @relation(fields: [contactGroupId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactGroupId, contactId])
}

model SystemSettings {
  id              String   @id @default("default")
  themeJson       String   @default("{}")
  faviconBase64   String?
  // F-229: último disparo do cron externo (observabilidade). JSON serializado com
  // timestamp, se foi autorizado, motivo/diagnóstico (sem vazar o segredo) e contagens.
  lastCronRunJson String?
  updatedAt       DateTime @updatedAt
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  ipAddress    String?
  userAgent    String?
  country      String?
  city         String?
  region       String?
  deviceType   String?   // "desktop" | "mobile" | "tablet"
  browser      String?
  os           String?
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactTemplate {
  id           String   @id @default(cuid())
  name         String
  variations   String   @default("[]")  // JSON array of message body strings
  mediaType    String?
  mediaUrl     String?
  mediaCaption String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User?             @relation("ContactTemplateCreator", fields: [createdById], references: [id])
  campaigns ContactCampaign[]

  @@index([createdById, createdAt])
}

model ContactCampaign {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  status               String    @default("draft")
  instanceId           String
  templateId           String
  variableValues       String    @default("{}")
  startAt              DateTime
  sendType             String    @default("scheduled")
  repeatType           String    @default("none")
  repeatEndAt          DateTime?
  nextRunAt            DateTime?
  runCount             Int       @default(0)
  cadenceMinSeconds    Int       @default(30)
  cadenceMaxSeconds    Int       @default(90)
  cadenceMaxPerHour    Int       @default(40)
  windowStart          String?
  windowEnd            String?
  windowDays           String    @default("[]")
  batchSize            Int?
  batchIntervalMinutes Int?
  repeatEveryX         Int?
  repeatEveryUnit      String?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  createdBy  User?                    @relation("ContactCampaignCreator", fields: [createdById], references: [id])
  instance   WhatsAppInstance         @relation(fields: [instanceId], references: [id])
  template   ContactTemplate          @relation(fields: [templateId], references: [id])
  contacts   ContactCampaignContact[]
  dispatches ContactCampaignDispatch[]
}

model ContactCampaignContact {
  id         String @id @default(cuid())
  campaignId String
  contactId  String
  order      Int    @default(0)

  campaign ContactCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact         @relation(fields: [contactId], references: [id])

  @@unique([campaignId, contactId])
}

model ContactCampaignDispatch {
  id           String    @id @default(cuid())
  campaignId   String
  contactId    String
  runIndex     Int       @default(0)
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  errorMessage String?
  messageId    String?
  variationIdx Int       @default(0)
  resolvedText String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign ContactCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact         @relation(fields: [contactId], references: [id])

  @@unique([campaignId, contactId, runIndex])
}

model SystemChangelog {
  id          String   @id @default(cuid())
  version     String
  title       String
  description String?
  changes     String   @default("[]")
  deployedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuickDispatch {
  id                String   @id @default(cuid())
  name              String?
  instanceId        String
  message           String
  mediaType         String?
  mediaUrl          String?
  mediaCaption      String?
  status            String   @default("scheduled")
  cadenceMinSeconds Int      @default(10)
  cadenceMaxSeconds Int      @default(30)
  cadenceMaxPerHour Int      @default(60)
  startAt           DateTime @default(now())
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  instance   WhatsAppInstance         @relation(fields: [instanceId], references: [id])
  createdBy  User?                    @relation("QuickDispatchCreator", fields: [createdById], references: [id])
  recipients QuickDispatchRecipient[]
}

model QuickDispatchRecipient {
  id              String    @id @default(cuid())
  quickDispatchId String
  phone           String
  varsJson        String    @default("{}")
  order           Int       @default(0)
  scheduledFor    DateTime
  sentAt          DateTime?
  status          String    @default("pending")
  errorMessage    String?
  messageId       String?
  resolvedText    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  quickDispatch QuickDispatch @relation(fields: [quickDispatchId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
}
